; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign value

config_version=5

[application]

config/name="Casual Games"
run/main_scene="res://scenes/games/SimplePet.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"

[autoload]

I18n="*res://scripts/conf/I18n.gd"
Config="*res://scripts/conf/Config.gd"
Theme="*res://scripts/conf/Theme.gd"
GlobalData="*res://scripts/common/GlobalData.gd"
SaveData="*res://scripts/common/SaveData.gd"
GameTimer="*res://scripts/common/GameTimer.gd"

[display]

window/size/viewport_width=200
window/size/viewport_height=200
window/stretch/mode="canvas_items"
window/size/width=200
window/size/height=200
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
;window/size/transparent=true  # 临时禁用透明测试
;window/size/no_focus=true     # 临时禁用无焦点测试
;window/per_pixel_transparency/allowed=true  # 临时禁用
window/title="桌面宠物测试"

[input]

click={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}

[physics]

2d/enable=true